  "last_docs_sync": "2026-09-28T09:35:37.739190Z",
  "schemas": {
    "skill_frontmatter": {
      "required": [],
      "recommended": [
        "description"
      ],
      "optional": [
        "name",
        "description",
        "when_to_use",
        "argument-hint",
        "arguments",
        "disable-model-invocation",
        "user-invocable",
        "allowed-tools",
        "disallowed-tools",
