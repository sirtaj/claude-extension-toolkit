        "effort",
        "context",
        "agent",
        "background",
        "hooks",
        "paths",
        "shell",
        "metadata",
        "license",
        "compatibility"
      ],
      "validation": {
        "name": {
          "max_length": 64,
          "pattern": "^[a-z0-9-]+$",
          "description": "lowercase letters, numbers, hyphens only",
          "no_xml_tags": true,
          "reserved_words": [
            "anthropic",
            "claude"
          ],
          "reserved_folder_names": [
            "synced",
            "anthropic-skills"
          ],
          "note": "Folder named 'synced' (any case) is skipped; outside a plugin, a folder or command file named 'anthropic-skills' or starting with 'anthropic-skills:' doesn't load"
        },
        "description": {
          "max_length": 1536,
          "spec_max_length": 1024,
          "no_xml_tags": true,
          "note": "Combined description + when_to_use truncated at 1536 chars in the skill listing (configurable via skillListingMaxDescChars); Agent Skills spec limit is 1024 chars, non-empty. If omitted, Claude Code uses the first non-empty line of the body"
        },
        "compatibility": {
          "max_length": 500
        },
        "booleans": "Accept true/false plus yes/no/on/off/1/0 in any case (v2.1.218+)"
      },
      "variables": [
        "$ARGUMENTS",
        "$ARGUMENTS[N]",
        "$N",
        "$name",
        "${CLAUDE_SESSION_ID}",
        "${CLAUDE_EFFORT}",
        "${CLAUDE_SKILL_DIR}",
        "${CLAUDE_PROJECT_DIR}",
        "${CLAUDE_PLUGIN_ROOT}",
        "${CLAUDE_PLUGIN_DATA}"
      ],
      "variables_note": "${CLAUDE_PLUGIN_ROOT} and ${CLAUDE_PLUGIN_DATA} are substituted only in plugin skills. ${CLAUDE_SKILL_DIR}, ${CLAUDE_PROJECT_DIR} and the plugin variables are also substituted in Bash rules in allowed-tools",
      "dynamic_context": "! followed by shell command in backticks",
      "agent_skills_spec_fields": [
        "name",
        "description",
        "license",
        "compatibility",
        "metadata",
        "allowed-tools"
      ],
      "notes": "All fields optional; description recommended. Fields outside agent_skills_spec_fields are Claude Code extensions and are rejected by claude.ai uploads and the Skills API."
    },
    "agent_frontmatter": {
      "required": [
        "name",
        "description"
      ],
      "optional": [
        "tools",
        "disallowedTools",
        "model",
        "effort",
        "color",
