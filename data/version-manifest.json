          "high",
          "xhigh",
          "max"
        ]
      },
      "validation": {
        "name": {
          "pattern": "^[a-z0-9-]+$",
          "description": "lowercase letters, numbers and hyphens, e.g. code-reviewer or reviewer-v2; a name that starts with '-' or contains ':' (reserved for plugin-scoped identifiers) prevents the file from loading"
        }
      }
