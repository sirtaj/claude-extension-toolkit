      "exit_codes": {
        "0": "Success; stdout parsed for JSON output fields",
        "2": "Blocking error on events that can block; JSON on stdout is still read but cannot override the block; message is the JSON block reason, else stderr",
        "other": "Non-blocking error; the action proceeds, unless stdout holds a valid JSON object, which then decides the outcome",
        "note": "JSON output fields are read on every exit code, not just 0. WorktreeCreate/WorktreeRemove fail on any non-zero exit"
      }
