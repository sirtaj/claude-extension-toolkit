    },
    "plugin_manifest": {
      "required": [
        "name"
      ],
      "optional": [
        "$schema",
        "displayName",
        "description",
        "version",
        "author",
        "homepage",
        "repository",
        "license",
        "keywords",
        "metadata",
        "defaultEnabled",
        "skills",
        "commands",
        "agents",
        "workflows",
        "hooks",
        "mcpServers",
        "outputStyles",
        "lspServers",
        "userConfig",
        "channels",
        "dependencies",
        "settings",
        "experimental"
      ],
      "experimental_keys": [
        "themes",
        "monitors",
        "evals"
      ],
      "notes": "The manifest itself is optional; without one, components are auto-discovered and the plugin name comes from the marketplace entry, or from the directory name under --plugin-dir. `name` must be non-empty with no spaces, `@`, `:`, path separators, control or bidi characters (kebab-case). Unrecognized top-level fields are stripped and the plugin loads (warning under `claude plugin validate`, failure under --strict); an unknown key inside a `userConfig` option, `channels` entry, `lspServers` config, or `monitors` entry is an error and the plugin doesn't load. `homepage` must parse as a URL. `settings` only honors `agent` and `subagentStatusLine`, and a root `settings.json` takes precedence. Top-level `themes`/`monitors` still load with a validate warning; use `experimental.*`.",
      "component_key_behavior": {
        "replaces_default": [
          "commands",
          "agents",
          "outputStyles",
          "workflows",
          "experimental.themes",
          "experimental.monitors"
        ],
        "adds_to_default": [
          "skills"
        ],
        "merges_with_default": [
          "hooks",
          "mcpServers",
          "lspServers"
        ]
      },
      "path_rules": "Component paths are relative to the plugin root and must start with `./`; they must resolve inside the root and exist. `skills` also accepts \".\" (v2.1.221+); `mcpServers` also accepts an https:// `.mcpb`/`.dxt` bundle URL.",
      "default_component_locations": {
        "skills": "skills/",
        "commands": "commands/",
        "agents": "agents/",
        "workflows": "workflows/",
        "output_styles": "output-styles/",
        "themes": "themes/",
        "hooks": "hooks/hooks.json",
        "mcp_servers": ".mcp.json",
        "lsp_servers": ".lsp.json",
        "monitors": "monitors/monitors.json",
        "evals": "evals/",
        "executables": "bin/",
        "settings": "settings.json"
      }
    },
    "marketplace_manifest": {
      "required": [
        "name",
        "owner",
        "plugins"
      ],
      "required_owner_fields": [
