        "claude-for-financial-services",
        "financial-services-plugins",
        "first-party-plugins",
        "healthcare"
      ],
      "reserved_name_note": "Names that impersonate official marketplaces (e.g. 'official-claude-plugins', 'anthropic-plugins-v2', 'claude-official') are also blocked; `claude plugin validate` reports those, and names with spaces or non-ASCII characters. The exact reserved names pass validate but `marketplace add` refuses them ('The name '<name>' is reserved for official Anthropic marketplaces'). Official and community names are accepted only for marketplaces sourced from github.com/anthropics/ repositories. Reserved names are re-checked on every marketplace load."
    },
    "marketplace_plugin_entry": {
      "required": [
        "name",
        "source"
      ],
      "optional": [
        "displayName",
        "description",
        "version",
        "author",
        "homepage",
        "repository",
        "license",
        "keywords",
        "metadata",
        "category",
        "tags",
        "strict",
        "relevance",
        "defaultEnabled",
        "skills",
        "commands",
        "agents",
        "hooks",
        "mcpServers",
        "lspServers",
        "outputStyles",
        "dependencies"
      ],
      "notes": "An entry accepts every plugin.json field alongside its own. Without a plugin.json the entry is the manifest (entry `hooks` only in inline-object form). With plugin.json and strict true/unset, entry commands/agents/skills/outputStyles/themes are appended and entry hooks replace the manifest's matchers per event; with strict false, an entry declaring any of those or hooks fails with 'Plugin <name> has conflicting manifests'. Entry defaultEnabled and display fields (displayName) override plugin.json; plugin.json version overrides the entry's. Entry name is the install id / enabledPlugins key; plugin.json name is the component namespace — keep them equal.",
      "field_types": {
        "author": {
          "type": "object",
          "required": [
            "name"
          ],
          "optional": [
            "email",
            "url"
          ]
        },
        "keywords": {
          "type": "array"
        },
        "homepage": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "source_types": {
        "relative_path": {
          "format": "string starting with ./",
          "disallowed": [
            "../"
          ]
        },
        "github": {
          "fields": {
            "repo": "required",
            "ref": "optional",
            "sha": "optional"
          }
        },
        "url": {
          "fields": {
            "url": "required",
            "ref": "optional",
            "sha": "optional"
          }
        },
        "git-subdir": {
          "fields": {
            "url": "required",
            "path": "required",
            "ref": "optional",
            "sha": "optional"
          },
          "description": "`url` takes a git URL or an owner/repo GitHub shorthand"
        },
        "npm": {
          "fields": {
            "package": "required",
            "version": "optional",
            "registry": "optional"
          }
        },
        "archive": {
          "fields": {
            "url": "required",
            "sha256": "optional"
          },
          "description": "Zip archive over HTTPS; requires Claude Code 2.1.224+"
        },
        "command": {
          "description": "A directory produced by running a command on the machine where the plugin is installed. Claude Code never auto-installs a `command`-source dependency, and plugin.json `version` doesn't pin it"
        }
      },
      "deprecated_fields": {
        "path": {
          "replacement": "source",
          "severity": "warning"
        }
      },
      "version_resolution": [
        "plugin.json version",
        "marketplace entry version",
        "git commit SHA of the plugin source",
        "archive sha256 pin or downloaded file digest"
      ],
      "version_resolution_notes": "`version` isn't checked against semver. It doesn't pin a plugin with a `command` source, one from a claude.ai-hosted marketplace, or one loaded in place from a marketplace added as a local directory. Dependency version constraints resolve against git tags named `<plugin-name>--v<version>` (git-backed sources only); for npm/archive/command sources the dependency's plugin.json `version` is checked at load."
    },
