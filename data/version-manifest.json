      "cli_agents_json": {
        "ignored": [
          "color",
          "experimental"
        ],
        "note": "--agents JSON uses 'prompt' for the system prompt and accepts the other frontmatter fields"
      },
      "field_values": {
        "memory": [
          "user",
          "project",
          "local"
        ],
        "isolation": [
