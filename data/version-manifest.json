    "permission_modes": {
      "values": [
        "default",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions",
        "plan",
        "manual"
      ],
      "descriptions": {
        "default": "Manual mode: standard permission prompts (only reads run without asking)",
        "acceptEdits": "Auto-approve file edits, prompt for others",
        "auto": "Auto mode: a background classifier reviews commands and protected-directory writes. Built-in starting mode for interactive terminal and VS Code sessions as of 2.1.283",
        "dontAsk": "Auto-deny permission prompts; explicitly allowed tools still work",
        "bypassPermissions": "Skip all permission prompts (dangerous)",
        "plan": "Read-only exploration (plus classifier-approved commands when auto mode is available); edits blocked until a plan is approved",
        "manual": "Alias for `default` (Claude Code 2.1.200+)"
      }
    },
